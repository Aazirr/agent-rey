# Copy to .env and fill in. Never commit the real file.
#
# EVERYTHING HERE IS DAEMON-ONLY. Do not add any of it to Vercel: the frontend is
# a static bundle that reads no environment variables, and the daemon's address is
# a runtime setting stored in the browser. The only Vercel-related variable is
# REY_ALLOWED_ORIGINS below, and it belongs HERE, on the daemon.
#
# These live on YOUR machine only — nothing here is ever sent to Vercel or any
# other host. In a real install this file is ~/.agent-rey/reyd.env, written with an
# owner-only ACL by scripts/install-service.ps1.

# ---- required ----
# Gate for the web app. A successful login yields an agent with shell access to
# this machine, so treat it like a root password: long, random, unique.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REY_PASSWORD=

# ---- network ----
# Loopback by default; `tailscale serve` fronts the daemon with TLS. Only change
# this if you know why you are exposing the port directly.
REY_HOST=127.0.0.1
REY_PORT=8787

# Origins allowed to open a WebSocket. Set this to your Vercel URL if you serve
# the PWA there. localhost is always allowed.
# REY_ALLOWED_ORIGINS=https://agent-rey.vercel.app

# ---- projects ----
# Semicolon- or comma-separated. The daemon will only ever start a session
# inside one of these; anything else is refused.
REY_PROJECT_ROOTS=~/Documents/Work/Projects

# How deep to look for project markers (.git, package.json, CLAUDE.md, …).
REY_SCAN_DEPTH=3

# ---- session defaults ----
# One of: default | acceptEdits | bypassPermissions | plan | dontAsk | auto
# Left at "default" deliberately: an unattended mode should be a per-session
# choice you make on purpose, not something the daemon assumes.
REY_DEFAULT_PERMISSION_MODE=default

# There is deliberately no spend ceiling. A ceiling kills a turn mid-work rather
# than pausing it, which on a phone reads as the session breaking for no reason.
# Cost is shown per turn and per session, and interrupt is always one tap away.

# REY_DEFAULT_MODEL=claude-opus-5

# Max simultaneous live sessions.
REY_MAX_SESSIONS=6

# ---- safety ----
# File checkpointing enables rewind, the only real undo for an unattended run.
REY_CHECKPOINTING=1

# Run tool calls in the SDK sandbox where the platform supports it.
REY_SANDBOX=0

# ---- housekeeping ----
# The daemon runs for months, so both of these are bounded.

# Stop a session after this many minutes with no activity, reclaiming its CLI
# process. Safe: a stopped session is resumable with its context intact, and a
# session that is actively working is never reaped. 0 disables.
REY_SESSION_IDLE_TIMEOUT_MIN=180

# Audit files are the accountability record for unattended sessions, so they
# outlive transcripts. 0 disables pruning.
REY_AUDIT_RETENTION_DAYS=90

# Per-session event logs. Logs for sessions still resumable are kept regardless
# of age. 0 disables.
REY_LOG_RETENTION_DAYS=30

# ---- misc ----
# REY_STATE_DIR=~/.agent-rey
# REY_SERVE_WEB=1
# REY_EVENT_BUFFER=2000
# Override the claude executable; normally the SDK's vendored binary is used.
# REY_CLAUDE_EXECUTABLE=
